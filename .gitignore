# dados do desafio — não podem ser redistribuídos (só nossos artefatos pequenos são versionados)
dados/*
!dados/.gitkeep
!dados/calibracao.json
# qualquer pasta de saída do pipeline (SAIDA=... também): os JSONs contêm trechos dos documentos do desafio
saida/
saida_*/
saida-*/
rastro*.jsonl
*.zip
__pycache__/
*.pyc
.ruff_cache/
.venv/
modelos/*
!modelos/revisao_fixa.env
cache_llm/

# artefatos locais (relatórios e submissões contêm trechos/ids do gabarito)
relatorio.json
relatorio_*.json
relatorio-*.json
submission.csv
submission_*.csv
submission-*.csv
