# Revisão FIXA dos pesos do árbitro LLM (MANIFESTO_MODELO.md; regra do desafio: pesos abertos
# com commit fixo). Único arquivo versionado de modelos/ — os pesos entram por volume.
#   source modelos/revisao_fixa.env && bash scripts/baixar_modelo.sh
# Desde a v1.3.0 (ADR 0003 "Medição 3"): Qwen3.5-9B carregado em NF4 (bitsandbytes) — CACA_LLM_4BIT
# entra na assinatura do backend e, portanto, na chave do cache: o cache_llm.jsonl da medição só
# responde com as três variáveis abaixo iguais.
export CACA_MODELO="Qwen/Qwen3.5-9B"
export CACA_MODELO_REVISAO="c202236235762e1c871ad0ccb60c8ee5ba337b9a"   # Apache-2.0
export CACA_LLM_4BIT="1"
# Alternativa medida (medições 1 e 2, ADR 0003; bf16, transformers 4.51.3 ou 5.16.1):
#   CACA_MODELO="Qwen/Qwen2.5-7B-Instruct" CACA_MODELO_REVISAO="a09a35458c702b33eeacc393d103063234e8bc28" CACA_LLM_4BIT=""   # main em 2025-01-11, Apache-2.0
# Quantizada oficial do Qwen2.5 (só se a VRAM apertar; requer autoawq):
#   CACA_MODELO="Qwen/Qwen2.5-7B-Instruct-AWQ" CACA_MODELO_REVISAO="b25037543e9394b818fdfca67ab2a00ecc7dd641"   # 2024-10-09
